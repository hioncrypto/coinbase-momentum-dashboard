# Copy to .env for local Docker, or set as variables on Railway / Fly.
# Never commit real values.

# --- SaaS gate (off by default) ---
SAAS_GATE_ENABLED=false
PUBLIC_PRICE_LABEL=Pro — $24/month
STRIPE_CHECKOUT_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth (Phase 1 — pick one provider later) ---
# CLERK_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# --- Database (Phase 1) ---
# DATABASE_URL=postgresql://...

# --- Email (Streamlit secrets also work — see secrets_template.toml) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Optional exchange overrides ---
# binance.api_base=https://api.binance.us
